<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>Iurin</display-name>
    <!-- Nama klub yang tampil di sidebar, login, dan judul tab. Ganti di sini saja. -->
    <context-param>
        <param-name>namaKlub</param-name>
        <param-value>PB Orang Pusing</param-value>
    </context-param>
    <!-- Naikkan angka ini setiap mengubah iurin.css supaya browser tidak memakai versi lama dari cache -->
    <context-param>
        <param-name>versiAset</param-name>
        <param-value>8</param-value>
    </context-param>
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
